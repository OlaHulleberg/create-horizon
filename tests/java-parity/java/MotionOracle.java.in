// Authored server contexts. Assembly, ticking order, entities and collision are not simulated.
import java.util.*;
public class MotionOracle {
 enum Axis {X,Y,Z}
 enum AxisDirection {NEGATIVE(-1),POSITIVE(1);int step;AxisDirection(int s){step=s;}int getStep(){return step;}}
 enum Direction {DOWN(Axis.Y,false),UP(Axis.Y,true),NORTH(Axis.Z,false),SOUTH(Axis.Z,true),WEST(Axis.X,false),EAST(Axis.X,true);
  Axis axis;boolean positive;Direction(Axis a,boolean p){axis=a;positive=p;}Axis getAxis(){return axis;}AxisDirection getAxisDirection(){return positive?AxisDirection.POSITIVE:AxisDirection.NEGATIVE;}}
 static class Setting {int value;Setting(int v){value=v;}int get(){return value;}int getValue(){return value;}}
 static class Config {Config kinetics=this;Setting windmillSailsPerRPM=new Setting(8),maxRopeLength=new Setting(384);}
 static class AllConfigs {static Config server(){return new Config();}}
 static class Mth {
  static int clamp(int x,int lo,int hi){return Math.min(Math.max(x,lo),hi);}
  static float clamp(float x,float lo,float hi){return Math.min(Math.max(x,lo),hi);}
  static double clamp(double x,double lo,double hi){return Math.min(Math.max(x,lo),hi);}
 }
 enum RotationDirection {CLOCKWISE,COUNTER_CLOCKWISE}
 static class BearingContraption {int sails;int getSailBlocks(){return sails;}}
 static class Moved {BearingContraption value=new BearingContraption();BearingContraption getContraption(){return value;}}
 static class Windmill {
  boolean running=true;Moved movedContraption=new Moved();float lastGeneratedSpeed;Setting movementDirection=new Setting(0);
  float getGeneratedSpeed() @@WINDMILL@@
  float getAngleSpeedDirection() @@DIRECTION@@
 }
 static class Position {int y;int getY(){return y;}}
 static class Level {boolean isClientSide=false;int min;int getMinBuildHeight(){return min;}}
 static class Pulley {Position worldPosition=new Position();Level level=new Level();int getExtensionRange() @@RANGE@@}
 static class ServerSpeedProvider {static float get(){return 1;}}
 static class Key<T> {}
 static class BlockStateProperties {static Key<Direction> FACING=new Key<>();}
 static class BlockState {Direction facing;@SuppressWarnings("unchecked") <T>T getValue(Key<T> k){return(T)facing;}}
 static class Base {
  Level level=new Level();float speed,clientOffsetDiff=0,offset;double sequencedOffsetLimit=-1;int extension=4;
  BlockState state=new BlockState();float getSpeed(){return speed;}BlockState getBlockState(){return state;}int getExtensionRange(){return extension;}
  static float convertToLinear(float speed) @@LINEAR@@
 }
 static class Linear extends Base {float getMovementSpeed() @@MOVEMENT@@}
 static class Piston extends Base {float getMovementSpeed() @@PISTON@@}
 static class AllBlocks {static AllBlocks GANTRY_SHAFT=new AllBlocks();boolean has(BlockState s){return true;}}
 static class Gantry extends Base {float getPinionMovementSpeed() @@GANTRY@@}
 public static void main(String[]args){var s=new Scanner(System.in);while(s.hasNext()){
  String op=s.next();float result;
  switch(op){
   case "W" -> {var w=new Windmill();w.movedContraption.value.sails=s.nextInt();w.movementDirection.value=s.nextInt();result=w.getGeneratedSpeed();}
   case "R" -> {var p=new Pulley();p.worldPosition.y=s.nextInt();p.level.min=s.nextInt();result=p.getExtensionRange();}
   case "L" -> {var p=new Linear();p.speed=s.nextFloat();result=p.getMovementSpeed();}
   case "P" -> {var p=new Piston();p.speed=s.nextFloat();p.state.facing=Direction.values()[s.nextInt()];p.offset=s.nextFloat();p.extension=s.nextInt();result=p.getMovementSpeed();}
   case "G" -> {var g=new Gantry();g.speed=s.nextFloat();result=g.getPinionMovementSpeed();}
   default -> throw new IllegalArgumentException(op);
  }
  System.out.println(result);
 }}
}
