{
  "multipart": [
    {
      "apply": {
        "model": "create:block/blaze_burner/block"
      }
    },
    {
      "when": {
        "blaze": "smouldering",
        "facing": "north"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/inert"
      }
    },
    {
      "when": {
        "blaze": "smouldering",
        "facing": "east"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/inert",
        "y": 90
      }
    },
    {
      "when": {
        "blaze": "smouldering",
        "facing": "south"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/inert",
        "y": 180
      }
    },
    {
      "when": {
        "blaze": "smouldering",
        "facing": "west"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/inert",
        "y": 270
      }
    },
    {
      "when": {
        "blaze": "fading",
        "facing": "north"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/idle"
      }
    },
    {
      "when": {
