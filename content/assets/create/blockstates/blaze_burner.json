        "facing": "west"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/idle",
        "y": 270
      }
    },
    {
      "when": {
        "blaze": "kindled",
        "facing": "north"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/idle"
      }
