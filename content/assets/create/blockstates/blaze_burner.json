    {
      "when": {
        "blaze": "seething",
        "facing": "north"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/super"
      }
    },
    {
      "when": {
        "blaze": "seething",
        "facing": "east"
      },
      "apply": {
        "model": "create:block/blaze_burner/blaze/super",
        "y": 90
      }
    },
