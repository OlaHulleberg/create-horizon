+pub(crate) fn flight_probe(host: &dyn ClientHost) {
+    if let Some(at) = DRAWN.get().and_then(|id| host.entity(id)).and_then(|e| e.position(host))
+        && LAST_DRAWN_AT.replace(Some(at)) != Some(at)
+    {
+        eprintln!("[flight] client position {at:?}");
+    }
+}
+
+pub(crate) fn ammo_probe(host: &mut dyn ServerHost, id: u32) -> Option<&'static str> {
+    Some(AMMO.get_existing(host, Holder::Entity(id)).ok()?.flatten()?.kind.id)
+}
