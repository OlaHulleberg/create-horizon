 struct Projectile;
+static DRAWN: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static PREV_CLIENT: std::sync::Mutex<Option<(u32, [f64; 3])>> = std::sync::Mutex::new(None);
+pub(crate) fn flight_probe(host: &dyn ClientHost) {
+    let id = DRAWN.load(std::sync::atomic::Ordering::Relaxed);
+    if let Some(p) = host.entity(id).and_then(|e| e.position(host)) {
+        let mut prev = PREV_CLIENT.lock().unwrap();
+        if Some((id, p)) != *prev {
+            eprintln!("[flight] client {id} {p:?}");
+            *prev = Some((id, p));
+        }
+    }
+}

